            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gatewayUrl}}/api/v1/auth/register",
            "description": "Anónimo. Gateway: /api/v1/auth/{everything} -> Identity /api/v1/auth/{everything}. Respuestas esperadas: 201, 400 o 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jorge\",\n  \"lastName\": \"Test\",\n  \"email\": \"jorge@test.com\",\n  \"password\": \"Testing123\",\n  \"phoneNumber\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gatewayUrl}}/api/v1/auth/login",
            "description": "Anónimo. Respuesta 200: LoginResponse con accessToken y refreshToken. El script guarda ambas como variables de colección.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jorge@test.com\",\n  \"password\": \"Testing123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gatewayUrl}}/api/v1/auth/refresh",
            "description": "Anónimo. Respuestas esperadas: 200, 400 o 401. Actualiza los tokens de colección si tiene éxito.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
