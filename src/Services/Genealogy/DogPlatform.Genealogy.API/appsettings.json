{
  "ConnectionStrings": {
    "GenealogyDb": ""
  },

  "Jwt": {
    "Issuer": "DogPlatform.Identity",
    "Audience": "DogPlatform",
    "Secret": ""
  },

  "PetsService": {
    "BaseUrl": "http://pets-api:8080"
  },

  "Genealogy": {
    "DefaultTreeDepth": 3,
    "MaximumTreeDepth": 10,
    "MaximumTraversalNodes": 1000
  },

  "GenealogyAnalysis": {
    "DefaultAnalysisDepth": 5,
    "MaximumAnalysisDepth": 10,
    "CloseRelationshipCoefficientThreshold": 0.125,
    "InbreedingWarningThreshold": 0.0625,
    "HighInbreedingThreshold": 0.125
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
